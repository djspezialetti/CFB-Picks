# Copy this file to .env and fill in real values before running the app.

# Port the app listens on
PORT=3000

# Set to "production" when running behind HTTPS (e.g. behind nginx with a real cert).
# Leave unset/"development" for local testing over plain http://localhost.
NODE_ENV=development

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: create an admin account automatically the first time you run
# `npm run init-db`. You (or your friend) will use this account to load
# each week's matchups from ESPN. Leave blank to skip.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: if set, anyone registering a new account must enter this
# exact code, so random strangers who stumble onto your site's /register
# page can't create accounts. Leave blank to allow open registration.
# Share this code privately with your group (text/Discord/etc.), not
# anywhere public.
REGISTRATION_CODE=
