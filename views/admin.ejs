<%- include('partials/header', { title: 'Admin' }) %>

<h1>Admin</h1>
<p class="lede">Pull matchups and scores from ESPN.</p>

<% if (message) { %><div class="success-msg"><%= message %></div><% } %>
<% if (error) { %><div class="error-msg"><%= error %></div><% } %>

<div class="admin-form">
  <h2 style="margin-top:0">Load a week</h2>
  <p class="lede">Fetches all FBS matchups for the given week. Safe to re-run — it updates existing games rather than duplicating them, so you can also use this to pull final scores once games are over.</p>
  <form method="POST" action="/admin/sync-week">
    <div class="row">
      <div class="field">
        <label for="seasonYear">Season year</label>
        <input type="number" id="seasonYear" name="seasonYear" value="<%= currentYear %>" required />
      </div>
      <div class="field">
        <label for="weekNumber">Week #</label>
        <input type="number" id="weekNumber" name="weekNumber" min="1" max="20" required />
      </div>
      <div class="field">
        <label for="seasonType">Season type</label>
        <select id="seasonType" name="seasonType">
          <option value="2" selected>Regular season</option>
          <option value="1">Preseason</option>
          <option value="3">Postseason / Bowls</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="label">Label (optional)</label>
      <input type="text" id="label" name="label" placeholder="e.g. Week 3" />
    </div>
    <button class="btn" type="submit">Pull from ESPN</button>
  </form>
</div>

<h2>Existing weeks</h2>
<% if (weeks.length === 0) { %>
  <p>No weeks loaded yet.</p>
<% } else { %>
  <table class="admin-weeks">
    <thead><tr><th>Label</th><th>Year</th><th>Type</th><th></th></tr></thead>
    <tbody>
      <% weeks.forEach(function(w) { %>
        <tr>
          <td><a href="/weeks/<%= w.id %>"><%= w.label %></a></td>
          <td><%= w.season_year %></td>
          <td><%= w.season_type === 2 ? 'Regular' : w.season_type === 1 ? 'Pre' : 'Post' %></td>
          <td>
            <form method="POST" action="/admin/refresh-scores/<%= w.id %>">
              <button class="btn secondary" type="submit">Refresh scores</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Manage players</h2>
<% if (users.length === 0) { %>
  <p>No accounts yet.</p>
<% } else { %>
  <table class="admin-weeks">
    <thead><tr><th>Name</th><th>Username</th><th>Admin?</th><th></th></tr></thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.username %></td>
          <td><%= u.is_admin ? 'Yes' : '' %></td>
          <td>
            <% if (u.id === currentUser.id) { %>
              <span class="lede" style="font-size:13px">That's you</span>
            <% } else { %>
              <form method="POST" action="/admin/delete-user/<%= u.id %>" onsubmit="return confirm('Remove <%= u.name %> and all of their picks? This can\'t be undone.');">
                <button class="btn secondary" type="submit">Delete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
