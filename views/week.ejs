<%- include('partials/header', { title: week.label }) %>

<h1><%= week.label %></h1>
<p class="lede"><%= week.season_year %> season · <%= games.length %> FBS matchup<%= games.length === 1 ? '' : 's' %></p>

<div class="week-tabs">
  <% weeks.forEach(function(w) { %>
    <a href="/weeks/<%= w.id %>" class="<%= w.id === week.id ? 'active' : '' %>"><%= w.label %></a>
  <% }) %>
</div>

<% if (games.length === 0) { %>
  <p>No games loaded for this week yet.</p>
<% } %>

<div id="matchups">
  <% let lastConference = null; %>
  <% games.forEach(function(g) { %>
    <% if (g.conference !== lastConference) { %>
      <h2 class="conference-heading"><%= g.conference || 'Other' %></h2>
      <% lastConference = g.conference; %>
    <% } %>
    <div class="matchup" data-game-id="<%= g.id %>">
      <% if (g.spread) { %><div class="matchup-spread"><%= g.spread %></div><% } %>
      <div class="team-col">
        <button
          class="team-btn away <%= g.myPick === 'away' ? 'picked' : '' %> <%= g.status === 'final' && g.winner ? (g.winner === 'away' ? 'correct' : 'wrong') : '' %>"
          data-side="away"
          <%= g.locked ? 'disabled' : '' %>
        >
          <span class="team-name">
            <% if (g.away_logo) { %><img class="team-logo" src="<%= g.away_logo %>" alt="" /><% } %>
            <span>
              <% if (g.away_rank) { %><span class="team-rank">#<%= g.away_rank %></span><% } %><%= g.away_team %>
              <% if (g.away_record) { %><span class="team-record"><%= g.away_record %><%= g.away_conf_record ? ' (' + g.away_conf_record + ')' : '' %></span><% } %>
            </span>
          </span>
          <% if (g.away_score !== null) { %><span class="team-score"><%= g.away_score %></span><% } %>
        </button>
        <% if (pickersByGame && pickersByGame[g.id]) { %>
          <div class="pickers">
            <% pickersByGame[g.id].away.forEach(function(name) { %>
              <span class="picker-chip <%= name === currentUser.name ? 'is-you' : '' %>"><%= name %></span>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="matchup-mid">
        <% if (g.status === 'final') { %>
          <span class="status-final">FINAL</span>
        <% } else if (g.status === 'in_progress') { %>
          <span class="status-live">LIVE</span>
        <% } else { %>
          <span class="kickoff"><%= new Date(g.start_time).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
        <% } %>
        <% if (g.location) { %>
          <span class="venue"><%= g.location %><%= g.is_neutral_site ? ' · Neutral site' : '' %></span>
        <% } %>
      </div>

      <div class="team-col">
        <button
          class="team-btn home <%= g.myPick === 'home' ? 'picked' : '' %> <%= g.status === 'final' && g.winner ? (g.winner === 'home' ? 'correct' : 'wrong') : '' %>"
          data-side="home"
          <%= g.locked ? 'disabled' : '' %>
        >
          <span class="team-name">
            <% if (g.home_logo) { %><img class="team-logo" src="<%= g.home_logo %>" alt="" /><% } %>
            <span>
              <% if (g.home_rank) { %><span class="team-rank">#<%= g.home_rank %></span><% } %><%= g.home_team %>
              <% if (g.home_record) { %><span class="team-record"><%= g.home_record %><%= g.home_conf_record ? ' (' + g.home_conf_record + ')' : '' %></span><% } %>
            </span>
          </span>
          <% if (g.home_score !== null) { %><span class="team-score"><%= g.home_score %></span><% } %>
        </button>
        <% if (pickersByGame && pickersByGame[g.id]) { %>
          <div class="pickers">
            <% pickersByGame[g.id].home.forEach(function(name) { %>
              <span class="picker-chip <%= name === currentUser.name ? 'is-you' : '' %>"><%= name %></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<% if (!canViewOthers) { %>
  <p class="locked-note">Make all of your picks for this week (or wait for the first kickoff) to see who picked what.</p>
<% } %>

<script src="/js/picks.js"></script>

<%- include('partials/footer') %>
