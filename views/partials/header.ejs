<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — The Pick \'Em Pool' : 'The Pick \'Em Pool' %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>" />
</head>
<body>
  <div class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">College Football<span class="brand-accent">Pick 'Ems</span></a>
      <% if (currentUser) { %>
        <nav class="topnav">
          <a href="/">Picks</a>
          <a href="/board">Board</a>
          <a href="/standings">Standings</a>
          <% if (currentUser.isAdmin) { %><a href="/admin">Admin</a><% } %>
          <span>Hi, <%= currentUser.name %></span>
          <form method="POST" action="/logout"><button class="linklike" type="submit">Log out</button></form>
        </nav>
      <% } %>
    </div>
  </div>
  <div class="wrap">
